{
  "name": "ristretto-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "install:jdks": "node scripts/install-jdks.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src scripts tests *.ts *.json *.html *.md public/*.html",
    "format:check": "prettier --check src scripts tests *.ts *.json *.html *.md public/*.html"
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "0.23.0",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.1",
    "@lezer/highlight": "1.2.3",
    "codemirror": "6.0.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@bytecodealliance/jco-transpile": "0.12.1",
    "@playwright/test": "1.63.0",
    "@types/node": "25.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
